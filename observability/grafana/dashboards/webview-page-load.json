{
  "title": "OTel Demo – WebView Page Load",
  "uid": "otel-demo-webview",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Requests under 50ms",
      "description": "Number of page-load spans whose duration is below 50 milliseconds.",
      "gridPos": { "x": 0, "y": 0, "w": 8, "h": 6 },
      "datasource": { "type": "tempo", "uid": "tempo" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "tempo", "uid": "tempo" },
          "queryType": "traceql",
          "query": "{ name = \"webview.page.load\" && duration < 50ms }"
        }
      ],
      "transformations": [
        {
          "id": "reduce",
          "options": {
            "reducers": ["count"],
            "includeTimeField": false
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "green", "value": null }]
          }
        }
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "orientation": "auto",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center"
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Requests under 100ms",
      "description": "Number of page-load spans whose duration is below 100 milliseconds.",
      "gridPos": { "x": 8, "y": 0, "w": 8, "h": 6 },
      "datasource": { "type": "tempo", "uid": "tempo" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "tempo", "uid": "tempo" },
          "queryType": "traceql",
          "query": "{ name = \"webview.page.load\" && duration < 100ms }"
        }
      ],
      "transformations": [
        {
          "id": "reduce",
          "options": {
            "reducers": ["count"],
            "includeTimeField": false
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "blue", "value": null }]
          }
        }
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "orientation": "auto",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Requests over 100ms",
      "description": "Number of page-load spans whose duration is 100 milliseconds or above.",
      "gridPos": { "x": 16, "y": 0, "w": 8, "h": 6 },
      "datasource": { "type": "tempo", "uid": "tempo" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "tempo", "uid": "tempo" },
          "queryType": "traceql",
          "query": "{ name = \"webview.page.load\" && duration >= 100ms }"
        }
      ],
      "transformations": [
        {
          "id": "reduce",
          "options": {
            "reducers": ["count"],
            "includeTimeField": false
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 1 }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "orientation": "auto",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center"
      }
    },
    {
      "id": 5,
      "type": "table",
      "title": "All Page Load Traces",
      "description": "All webview.page.load spans emitted during the selected time range.",
      "gridPos": { "x": 0, "y": 16, "w": 24, "h": 10 },
      "datasource": { "type": "tempo", "uid": "tempo" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "tempo", "uid": "tempo" },
          "queryType": "traceql",
          "query": "{ name = \"webview.page.load\" }",
          "limit": 100
        }
      ],
      "options": {
        "showHeader": true,
        "sortBy": [{ "displayName": "Start time", "desc": true }],
        "footer": { "show": true, "reducer": ["count"], "countRows": true }
      }
    },
    {
      "id": 6,
      "type": "table",
      "title": "Page Loads by App Version",
      "description": "Count and average duration of page loads grouped by app version.",
      "gridPos": { "x": 0, "y": 6, "w": 12, "h": 10 },
      "datasource": { "type": "tempo", "uid": "tempo" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "tempo", "uid": "tempo" },
          "queryType": "traceql",
          "query": "{ name = \"webview.page.load\" && .app.version != nil } | select(.app.version, duration)",
          "limit": 100,
          "tableType": "spans",
          "spss": 10
        }
      ],
      "transformations": [
        {
          "id": "groupBy",
          "options": {
            "fields": {
              "app.version": {
                "aggregations": [],
                "operation": "groupby"
              },
              "duration": {
                "aggregations": ["count", "mean"],
                "operation": "aggregate"
              }
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "duration (mean)" },
            "properties": [{ "id": "unit", "value": "ns" }]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "sortBy": [{ "displayName": "duration (count)", "desc": true }]
      }
    },
    {
      "id": 7,
      "type": "table",
      "title": "Page Loads by API Level",
      "description": "Count and average duration of page loads grouped by device API level.",
      "gridPos": { "x": 12, "y": 6, "w": 12, "h": 10 },
      "datasource": { "type": "tempo", "uid": "tempo" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "tempo", "uid": "tempo" },
          "queryType": "traceql",
          "query": "{ name = \"webview.page.load\" && .device.api_level != nil } | select(.device.api_level, duration)",
          "limit": 100,
          "tableType": "spans",
          "spss": 10
        }
      ],
      "transformations": [
        {
          "id": "groupBy",
          "options": {
            "fields": {
              "device.api_level": {
                "aggregations": [],
                "operation": "groupby"
              },
              "duration": {
                "aggregations": ["count", "mean"],
                "operation": "aggregate"
              }
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "duration (mean)" },
            "properties": [{ "id": "unit", "value": "ns" }]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "sortBy": [{ "displayName": "duration (count)", "desc": true }]
      }
    }
  ]
}
